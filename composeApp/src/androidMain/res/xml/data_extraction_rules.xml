<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-transfer rules. The auth token lives in
  EncryptedSharedPreferences ("osta_rosto_secure"); its master key is bound to
  this device's Keystore, so a restored copy can't be decrypted and would crash
  on read. Exclude it from every transfer path.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="osta_rosto_secure.xml" />
        <exclude domain="sharedpref" path="osta_rosto_secure_fallback.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="osta_rosto_secure.xml" />
        <exclude domain="sharedpref" path="osta_rosto_secure_fallback.xml" />
    </device-transfer>
</data-extraction-rules>
